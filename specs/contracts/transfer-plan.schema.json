{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "transfer-plan.schema.json",
  "title": "Normalized internal transfer plan",
  "description": "Draft service-owned plan. Schema validity does not confer authority or establish semantic validity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "version", "action", "actor_id", "source_account_id", "recipient_id", "destination_account_id", "amount_minor", "fee_minor", "total_debit_minor", "currency", "execute_at", "expires_at", "policy_version", "account_state_version", "plan_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0", "readOnly": true},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 128, "readOnly": true},
    "version": {"type": "integer", "minimum": 1, "readOnly": true},
    "action": {"const": "transfer"},
    "actor_id": {"type": "string", "minLength": 1, "maxLength": 128, "readOnly": true},
    "source_account_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "recipient_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "destination_account_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "amount_minor": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "fee_minor": {"type": "integer", "minimum": 0, "maximum": 9007199254740991, "readOnly": true},
    "total_debit_minor": {"type": "integer", "minimum": 1, "maximum": 9007199254740991, "readOnly": true},
    "currency": {"const": "CNY"},
    "execute_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time", "readOnly": true},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 128, "readOnly": true},
    "account_state_version": {"type": "integer", "minimum": 0, "readOnly": true},
    "plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$", "readOnly": true}
  },
  "x-semantic-constraints": [
    "total_debit_minor = amount_minor + fee_minor",
    "All identifiers are resolved under the trusted authenticated actor",
    "Approval must be current and bound to this exact service-owned plan",
    "Times are normalized with explicit timezone before hash computation",
    "Maximum safe JSON integer is a representation ceiling, not a transaction limit",
    "Hash alone is not a signature or an approval"
  ],
  "x-demo-hash-serialization": "SHA256(UTF8(JSON of all fields except plan_hash; sorted keys; no whitespace; ensure_ascii=false; no floating point values)). Python and TypeScript compatibility requires test vectors before implementation."
}
